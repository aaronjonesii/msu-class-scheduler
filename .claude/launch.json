{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-with-emulators",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/firebase-dev.ps1",
        "emulators:exec",
        "--only",
        "auth,firestore",
        "--import=seed",
        "npm run start:development"
      ],
      "port": 4200
    }
  ]
}
